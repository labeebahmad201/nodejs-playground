      "seed": 864872681,
      "version": 1,
      "versionNonce": 733629444,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793805051133,
      "link": null,
      "locked": false,
      "text": "Also in the wider palette: white = UI sketch, dark green = opportunity, red/green = value. Add them to the legend if you use them.",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Also in the wider palette: white = UI sketch, dark green = opportunity, red/green = value. Add them to the legend if you use them.",
